generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== USERS ==================
model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  phone         String?
  gender        String?
  avatarId      String?
  avatar        Media?         @relation("UserAvatar", fields: [avatarId], references: [id])
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  isActive      Boolean        @default(true)
  refreshTokens RefreshToken[]
  uploadedMedia Media[]        @relation("UploadedMedia")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ================== ROLES ==================
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  status      Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// ================== PERMISSIONS ==================

model PermissionGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]

  @@map("permission_groups")
}

model Permission {
  id            String           @id @default(uuid())
  name          String           @unique
  description   String?
  parentGroupId String?
  parentGroup   PermissionGroup? @relation(fields: [parentGroupId], references: [id])
  roles         RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ================== MEDIA ==================

model Media {
  id         String  @id @default(uuid())
  fileName   String
  storedPath String
  publicUrl  String
  mimeType   String
  type       String // "image" | "video"
  size       Int
  width      Int?
  height     Int?
  thumbnail  String?
  altText    String?
  title      String?

  uploadedById String?
  uploadedBy   User?   @relation("UploadedMedia", fields: [uploadedById], references: [id])

  usedAsAvatarBy     User[]           @relation("UserAvatar")
  categories         Category[]       @relation("CategoryImage")
  brands             Brand[]          @relation("BrandLogo")
  productAttachments ProductMedia[]
  attributeValueRefs AttributeValue[] @relation("AttributeValueReferenceMedia")

  createdAt DateTime @default(now())

  @@map("media")
}

// ================== CATEGORY ==================

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  imageId     String?
  image       Media?  @relation("CategoryImage", fields: [imageId], references: [id])

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  activeFlag Boolean @default(true)
  sortOrder  Int     @default(0)

  products ProductCategory[] // many-to-many via join table only — no direct Product relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

// ================== BRAND ==================

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoId      String?
  logo        Media?    @relation("BrandLogo", fields: [logoId], references: [id])
  status      Boolean   @default(true)
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

// ================== ATTRIBUTES ==================

model Attribute {
  id     String           @id @default(uuid())
  name   String           @unique
  slug   String           @unique
  type   String // 'dropdown' | 'radio' | 'checkbox' | 'colour_swatch' | 'image_swatch'
  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id               String  @id @default(uuid())
  value            String
  slug             String
  referenceValue   String? // hex code, used when attribute type = colour_swatch
  referenceMediaId String? // media reference, used when attribute type = image_swatch
  referenceMedia   Media?  @relation("AttributeValueReferenceMedia", fields: [referenceMediaId], references: [id])

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variants      ProductVariantAttribute[]
  attachedMedia ProductMedia[]            @relation("AttributeValueMedia")

  @@unique([attributeId, value]) // unique within its own attribute
  @@map("attribute_values")
}

// ================== PRODUCT ==================

model Product {
  id               String  @id @default(uuid())
  name             String
  slug             String  @unique
  shortDescription String?
  longDescription  String?

  hasVariants Boolean @default(false)

  sku         String?  @unique
  price       Decimal? @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  stock       Int?
  stockStatus String? // "in_stock" | "low_stock" | "out_of_stock"

  weight       Decimal? @db.Decimal(10, 2)
  activeFlag   Boolean  @default(true)
  featuredFlag Boolean  @default(false)
  sortOrder    Int      @default(0)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  categories ProductCategory[] // many-to-many, no direct categoryId
  media      ProductMedia[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("product_categories")
}

// Polymorphic-style attachment: exactly one of productId / variantId / attributeValueId is set.
model ProductMedia {
  id      String @id @default(uuid())
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String?
  attributeValue   AttributeValue? @relation("AttributeValueMedia", fields: [attributeValueId], references: [id], onDelete: Cascade)

  isThumbnail Boolean @default(false)
  isGallery   Boolean @default(true)
  sortOrder   Int     @default(0)

  @@map("product_media")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku         String   @unique
  price       Decimal  @db.Decimal(10, 2)
  salePrice   Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  stockStatus String?

  lowStockThreshold Int?     @default(5)
  weight            Decimal? @db.Decimal(10, 2)
  activeFlag        Boolean  @default(true)

  attributes ProductVariantAttribute[]
  media      ProductMedia[] // polymorphic — via ProductMedia.variantId, no separate join table

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

model ProductVariantAttribute {
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("product_variant_attributes")
}
